# 암호화 키 (32바이트 hex)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# 검색용 HMAC 키 (암호화 키와 분리, 최소 32바이트)
SEARCH_SECRET_KEY=your-32-byte-search-secret-key-here

# 글로벌 페퍼 (레인보우 테이블 방어, 최소 16바이트)
GLOBAL_PEPPER=your-16-byte-global-pepper-here

# 암호화 알고리즘 (기본값: aes-256-cbc)
ENCRYPTION_ALGORITHM=aes-256-cbc

# 암호화 IV 길이 (기본값: 16)
ENCRYPTION_IV_LENGTH=16

# Scrypt 솔트 (기본값: salt)
ENCRYPTION_SCRYPT_SALT=salt

# HMAC 알고리즘 (기본값: sha256)
ENCRYPTION_HMAC_ALGORITHM=sha256

# 로그 레벨 (error, warn, info, http, debug, 기본값: info)
LOG_LEVEL=info

# 데이터포털 API 키 (디코딩된 서비스 키)
BUSINESS_STATUS_API_KEY=YOUR_DECODED_SERVICE_KEY

# 페이지네이션 기본 아이템 수
DEFAULT_ITEM_COUNT=20